###############################################################################
# PrintPalash website and admin dashboard — environment template
#
# Copy to `.env.local` for local development; that file is git-ignored. On
# Vercel these go in Project → Settings → Environment Variables instead, and
# this file is never read there.
#
# Nothing below is a real secret. Every value is a placeholder, and anything
# written as <like-this> has to be replaced with a value you obtain yourself.
#
# Two kinds of variable, and the difference matters:
#
#   NEXT_PUBLIC_*  compiled into the JavaScript the browser downloads. Anyone
#                  who visits the site can read it. Only ever a public value.
#
#   everything     readable only by the Next server, in route handlers and
#   else           server components. Never sent to the browser.
#
# Giving a secret the NEXT_PUBLIC_ prefix publishes it. There is no way to
# un-publish it afterwards, because it is baked into files already downloaded.
#
# The database connection string, the JWT signing key, the Cloudinary API
# secret and the Brevo API key belong to the API on Render. None of them has an
# entry here, in either kind, and none should ever be added.
#
# All of these are read at build time, so changing one in Vercel needs a
# redeploy. Saving the variable alone does nothing.
###############################################################################


# ===========================================================================
# BACKEND API
# ===========================================================================

# ---------------------------------------------------------------------------
# NEXT_PUBLIC_API_URL        PUBLIC (in the browser bundle)        REQUIRED
# ---------------------------------------------------------------------------
# The ASP.NET Core API's public address. Scheme and host, no trailing path and
# no trailing slash.
#
# Where to get it: Render → your Web Service → the URL at the top of the page.
# It does not exist until the API has been deployed once, so deploy the API
# first and copy the real URL from Render. Do not guess it.
#
# Public on purpose. The dashboard runs in the browser and calls the API
# directly, so this address is in the bundle by necessity. It is not a secret:
# the API authorises every single request itself, and hiding its address was
# never what stopped anyone.
#
# Set this together with Cors__AllowedOrigins on Render, which must name this
# site's origin. They are two halves of one setting and neither works alone.
#
# Required in production. Unset locally, the dashboard falls back to
# http://localhost:5080. That fallback deliberately does not survive a
# production build: a deploy without this variable used to bake localhost into
# every staff member's browser and then report a network error that blamed
# their connection. It now reports a configuration error naming this variable.
NEXT_PUBLIC_API_URL=https://<your-render-service>.onrender.com

# ---------------------------------------------------------------------------
# API_URL                    SERVER ONLY                          OPTIONAL
# ---------------------------------------------------------------------------
# The same address, for the Next server only. Read by the public order-tracking
# proxy at app/api/track/[trackingNumber]/route.ts, which calls the API from the
# server so the marketing pages never make a cross-origin request of their own.
#
# Optional: it falls back to NEXT_PUBLIC_API_URL, so setting that one alone is
# enough. Worth setting only if the Next server should reach the API by a
# different address than the browser does — an internal hostname, say.
#
# One of the two must be set in production. With neither, order tracking logs
# that it cannot reach the API and answers visitors with the same wording as an
# outage.
# API_URL=https://<your-render-service>.onrender.com


# ===========================================================================
# WEBSITE ENQUIRY EMAIL                                           OPTIONAL
# ===========================================================================
# A plain SMTP copy of website order enquiries, for the shop's own records.
#
# Separate from Brevo, and easy to confuse with it. Brevo sends customer
# invoices and receipts, from the API on Render, using Brevo__ApiKey there.
# This sends an internal notification from the website, over SMTP. Two
# different paths, two different sets of credentials.
#
# Entirely optional. Unset, the endpoint answers 202 saying mail is not
# configured, and the customer's enquiry is unaffected: the order reaches the
# sales team over WhatsApp, which does not depend on this at all. It used to
# fall back to a throwaway test inbox, which looked like it was sending and
# delivered nothing — hence the explicit "not configured" instead.
#
# All four are SERVER ONLY. SMTP_PASS is a real secret. None of these may ever
# gain the NEXT_PUBLIC_ prefix.
#
# Where to get them: whichever mail provider sends this. Brevo's own SMTP relay
# works, under Brevo → SMTP & API → SMTP, which issues an SMTP key separate
# from the v3 API key the backend uses.

# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=<your-smtp-login>
# SMTP_PASS=<your-smtp-key>

# Who the notification comes from and who receives it. Both fall back to
# SMTP_USER. SERVER ONLY, neither is a secret.
# FROM_EMAIL=website@printpalash.com
# TO_EMAIL=orders@printpalash.com


# ===========================================================================
# ANALYTICS                                                       OPTIONAL
# ===========================================================================

# ---------------------------------------------------------------------------
# NEXT_PUBLIC_GA_ID          PUBLIC (in the browser bundle)        OPTIONAL
# ---------------------------------------------------------------------------
# Google Analytics measurement id, from Google Analytics → Admin → Data streams.
#
# Public by design: a measurement id is visible in the page source of every
# site that uses one, so the prefix is correct here.
#
# The code already carries the live id as a default, so leave this unset unless
# you are pointing a deployment at a different property.
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
